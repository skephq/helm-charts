{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "skep-collector values",
  "type": "object",
  "required": ["mode", "image", "skep", "backend", "sampling"],
  "properties": {
    "mode": { "type": "string", "enum": ["agent", "gateway"] },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": ["string", "number"] },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "skep": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string" },
        "environment": { "type": ["string", "number"] },
        "fleet": { "type": ["string", "number"] },
        "tier": { "type": "string", "enum": ["", "edge", "gateway"] },
        "collectorName": { "type": ["string", "number"] },
        "existingSecret": { "type": "string" }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["none", "honeycomb", "otlp", "gateway", "file"] },
        "otlpEndpoint": { "type": "string" },
        "gatewayEndpoint": { "type": "string" }
      }
    },
    "sampling": { "type": "string", "enum": ["none", "tail_sampling"] },
    "systemLogs": { "type": "boolean" },
    "opamp": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string" }
      }
    },
    "config": { "type": "object" },
    "secret": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "skepApiKey": { "type": "string" },
        "honeycombApiKey": { "type": "string" }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "goMemLimit": { "type": "string" },
    "hostPorts": { "type": "boolean" }
  }
}
